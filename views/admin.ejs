<%- include('partials/top') %>
<h1>Admin</h1>
<h2>Hotels</h2>
<div class="tablewrap card flush">
<table class="grid">
  <thead><tr><th>Name</th><th>Code</th><th>Time zone</th><th class="n">Rooms</th><th class="n">Staff</th><th></th></tr></thead>
  <tbody>
  <% properties.forEach(p => { %>
    <tr>
      <td><input form="pf<%= p.id %>" name="name" value="<%= p.name %>" aria-label="Hotel name" required></td>
      <td><input form="pf<%= p.id %>" name="code" value="<%= p.code || '' %>" aria-label="Code" size="8"></td>
      <td><select form="pf<%= p.id %>" name="timezone" aria-label="Time zone"><% timezones.forEach(t => { %><option <%= t === p.timezone ? 'selected' : '' %>><%= t %></option><% }) %></select></td>
      <td class="n"><a href="/p/<%= p.id %>/rooms"><%= p.rooms %></a></td>
      <td class="n"><a href="/p/<%= p.id %>/staff"><%= p.staff %></a></td>
      <td class="r">
        <form id="pf<%= p.id %>" method="post" action="/admin/properties/<%= p.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small" type="submit">Save</button></form>
        <a class="btn small" href="/p/<%= p.id %>">Open</a>
      </td>
    </tr>
  <% }) %>
  <% if (!properties.length) { %><tr><td colspan="6" class="muted">No hotels yet. Add the first one below.</td></tr><% } %>
  </tbody>
</table>
</div>
<form method="post" action="/admin/properties" class="card row">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>New hotel name<input name="name" required placeholder="Hampton Inn Shelton"></label>
  <label>Code (optional)<input name="code" size="8"></label>
  <label>Time zone<select name="timezone"><% timezones.forEach(t => { %><option><%= t %></option><% }) %></select></label>
  <button class="btn primary" type="submit">Add hotel</button>
</form>

<h2>Sign-ins</h2>
<div class="tablewrap card flush">
<table class="grid">
  <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Hotel</th><th>Reset password</th><th></th></tr></thead>
  <tbody>
  <% users.forEach(u => { %>
    <tr class="<%= u.active ? '' : 'off' %>">
      <td><%= u.name %><% if (!u.active) { %> <span class="pill">off</span><% } %></td>
      <td><%= u.email %></td>
      <td><%= roleLabels[u.role] %></td>
      <td><%= u.property_name || 'All hotels' %></td>
      <td>
        <form method="post" action="/admin/users/<%= u.id %>/password" class="inline row tight">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="password" name="password" minlength="10" placeholder="New password" aria-label="New password for <%= u.name %>" autocomplete="new-password" required>
          <button class="btn small" type="submit">Reset</button>
        </form>
      </td>
      <td class="r">
        <% if (u.id !== user.id) { %>
        <form method="post" action="/admin/users/<%= u.id %>/toggle" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn small" type="submit"><%= u.active ? 'Turn off' : 'Turn on' %></button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<form method="post" action="/admin/users" class="card row">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Name<input name="name" required></label>
  <label>Email<input type="email" name="email" required></label>
  <label>Role<select name="role"><% Object.keys(roleLabels).forEach(r => { %><option value="<%= r %>" <%= r === 'gm' ? 'selected' : '' %>><%= roleLabels[r] %></option><% }) %></select></label>
  <label>Hotel<select name="property_id"><option value="">All hotels (admin only)</option><% properties.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label>
  <label>Starting password<input type="password" name="password" minlength="10" autocomplete="new-password" required></label>
  <button class="btn primary" type="submit">Add sign-in</button>
</form>
<%- include('partials/bottom') %>
